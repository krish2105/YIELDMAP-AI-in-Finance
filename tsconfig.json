{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "web/lib/kpi.ts",
    "web/lib/kpi.test.ts",
    "web/lib/format.ts",
    "web/lib/theme.ts"
  ],
  "exclude": [
    "node_modules",
    "web/node_modules",
    "web/.next",
    "web/app",
    "web/components"
  ]
}
