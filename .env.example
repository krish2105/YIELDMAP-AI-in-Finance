# ---------------------------------------------------------------------------
# YIELDMAP environment. Copy to .env and fill in. Never commit .env.
# Zero paid inference: the provider order is Ollama -> Gemini -> Groq.
# ---------------------------------------------------------------------------

# Provider selection. One of: ollama | gemini | groq | fake | anthropic
# "fake" uses recorded fixtures and needs no key — this is what CI runs.
# The chain falls through automatically when a tier is unavailable.
LLM_PROVIDER=ollama

# Local tier (absent in the cloud sandbox; present on a laptop)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Free API tiers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Present but OFF. Setting a key here does not enable it; LLM_PROVIDER must
# also be set to anthropic, which the budget guard refuses by default.
ANTHROPIC_API_KEY=
ANTHROPIC_ENABLED=false

# Request-count budgets (quotas are requests, not tokens)
LLM_MAX_REQUESTS_PER_DAY=1000
AGENT_MAX_REQUESTS_PER_RUN=40
AGENT_MAX_SECONDS_PER_RUN=180

# Storage
DUCKDB_PATH=data/yieldmap.duckdb
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# API / web
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Authentication -------------------------------------------------------------------------
# The key this service signs tokens with. Unset, a random one is generated per process: fine
# locally, wrong in a deployment, where two instances would reject each other's tokens.
AUTH_SECRET=
# Accounts, semicolon separated, as `email:role:argon2-hash`. Roles: viewer, analyst, admin.
# Generate a hash with:  uv run python -m api.auth hash 'the-password'
YIELDMAP_USERS=
# How long an issued token lasts.
AUTH_TOKEN_TTL_HOURS=12
# Set to `production` to make the service refuse to start unconfigured rather than warn.
YIELDMAP_ENV=development

# --- Storage --------------------------------------------------------------------------------
# Postgres for memos. Unset, they go to a file store that is ephemeral on a container: every
# memo is lost on restart. GET /health reports which one is in use.
DATABASE_URL=
# Used only by the test suite, to run the Postgres storage tests against a real database.
TEST_DATABASE_URL=

# --- Observability --------------------------------------------------------------------------
# Error tracking. Unset, Sentry stays off and the service runs normally.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=INFO
