# ---------------------------------------------------------------------------
# YIELDMAP environment. Copy to .env and fill in. Never commit .env.
# Zero paid inference: the provider order is Ollama -> Gemini -> Groq.
# ---------------------------------------------------------------------------

# Provider selection. One of: ollama | gemini | groq | fake | anthropic
# "fake" uses recorded fixtures and needs no key — this is what CI runs.
# The chain falls through automatically when a tier is unavailable.
LLM_PROVIDER=ollama

# Local tier (absent in the cloud sandbox; present on a laptop)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Free API tiers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Present but OFF. Setting a key here does not enable it; LLM_PROVIDER must
# also be set to anthropic, which the budget guard refuses by default.
ANTHROPIC_API_KEY=
ANTHROPIC_ENABLED=false

# Request-count budgets (quotas are requests, not tokens)
LLM_MAX_REQUESTS_PER_DAY=1000
AGENT_MAX_REQUESTS_PER_RUN=40
AGENT_MAX_SECONDS_PER_RUN=180

# Storage
DUCKDB_PATH=data/yieldmap.duckdb
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# API / web
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
CORS_ALLOW_ORIGINS=http://localhost:3000
